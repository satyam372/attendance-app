# Copy this file to .env and fill in real values.
# Never commit .env. On Vercel, set these in Project Settings > Environment Variables.

# ---------- App ----------
# local | production  (production enables stricter checks: JWT_SECRET length, COOKIE_SECURE)
ENVIRONMENT=local

# ---------- Database ----------
# One shared Supabase project for local dev and production: be careful, this is real data.
# Supabase > Connect > Session pooler (port 5432) for local dev and Alembic.
# Vercel uses the Transaction pooler (port 6543) instead.
# Never point pytest at this database.
# Prefix must be postgresql+psycopg:// (psycopg 3). URL-encode special chars in the password.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------- JWT ----------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be 32+ random characters outside local.
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

# ---------- Auth cookie ----------
# Frontend and backend share one domain (Vercel services), so COOKIE_DOMAIN stays empty everywhere.
# Local: COOKIE_SECURE=false. Production: COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# ---------- CORS ----------
# JSON list of origins allowed to call the API directly.
# Not needed in production (same origin) or locally via the Parcel /api proxy;
# kept for tools that call the API from another origin.
CORS_ORIGINS=["http://localhost:1234"]

# ---------- Business rules (optional, defaults live in config.py) ----------
# TIMEZONE=Asia/Kolkata
# OFFICE_START=10:30
# OFFICE_END=19:30
# LATE_BUFFER_MIN=30
# WFH_FREE_DAYS_PER_MONTH=2

# ---------- Email (Microsoft 365 SMTP) ----------
# Leave MAIL_USERNAME empty to disable sending (emails are only logged). Keep it empty locally
# unless you are testing email. The mailbox needs SMTP AUTH enabled by the M365 admin.
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM=attendance@speedinnovations.in   (defaults to MAIL_USERNAME)
# MAIL_FROM_NAME=SpeedIn Attendance
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# Link shown in emails. Production: https://<your-app>.vercel.app
APP_URL=http://localhost:1234

# ---------- Office location (OFFICE check-in) ----------
# Required. Google Maps → right-click the office → click the coordinates to copy.
OFFICE_LAT=18.5492
OFFICE_LNG=73.9163
# How far from the office still counts as "at the office" (metres)
OFFICE_RADIUS_M=150
# Locations less precise than this are rejected (metres); raise it if office laptops get
# "location not precise enough". Worst case accepted is roughly radius + this value.
OFFICE_MAX_ACCURACY_M=300
