# Copy this file to .env and fill in real values.
# Never commit .env. On Vercel, set these in Project Settings > Environment Variables.

# ---------- App ----------
# local | dev | qa | production  (non-local enables stricter checks, e.g. JWT_SECRET length)
ENVIRONMENT=local

# ---------- Database ----------
# Supabase > Connect > Session pooler (port 5432) for local dev and Alembic.
# Vercel uses the Transaction pooler (port 6543) instead.
# Prefix must be postgresql+psycopg:// (psycopg 3). URL-encode special chars in the password.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------- JWT ----------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be 32+ random characters outside local.
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

# ---------- Auth cookie ----------
# Local: COOKIE_SECURE=false, COOKIE_DOMAIN empty.
# Production: COOKIE_SECURE=true, COOKIE_DOMAIN=.company.com
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# ---------- CORS ----------
# JSON list of frontend origins allowed to call the API (Parcel dev server is :1234).
CORS_ORIGINS=["http://localhost:1234"]

# ---------- Business rules (optional, defaults live in config.py) ----------
# TIMEZONE=Asia/Kolkata
# OFFICE_START=10:30
# OFFICE_END=19:30
# LATE_BUFFER_MIN=30
# WFH_FREE_DAYS_PER_MONTH=2
