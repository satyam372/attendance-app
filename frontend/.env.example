# Copy this file to .env for local development. Never commit .env.
# Parcel inlines these at build time: restart `npm run dev` after changing them.

# Base path of the backend API. Same origin in production (Vercel services) and
# locally through the Parcel proxy in .proxyrc.
API_URL=/api

# true: use the in-browser mock API (seeded demo data, no backend needed).
# false or unset: call the real backend at API_URL.
USE_MOCK_API=true
